   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Suppositions: Standard Proof Techniques in Discrete Mathematics and Example Applications</rdf:li>
     <rdf:li xml:lang="en-US">Suppositions: Standard Proof Techniques in Discrete Mathematics and Example Applications</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Discrete Mathematics</rdf:li>
     <rdf:li>Proof Techniques</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:type>
    <rdf:Bag>
     <rdf:li>Text</rdf:li>
    </rdf:Bag>
   </dc:type>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">This document examines standard proof techniques found in discrete mathematics. It combines meticulous explanations with example applications to accessibly define and demonstrate each approach.</rdf:li>
     <rdf:li xml:lang="en-US">This document examines standard proof techniques found in discrete mathematics. It combines meticulous explanations with example applications to accessibly define and demonstrate each approach.</rdf:li>
    </rdf:Alt>
   </dc:description>
